# pkg-config for libtabnasjsonc (tabnas-clib-template: v1)
# Install alongside the built library; substitute @PREFIX@ at install.
prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libtabnasjsonc
Description: jsonc parser (libtabnasjsonc) — uniform tabnas C ABI (ADR-12)
Version: @VERSION@
Libs: -L${libdir} -ltabnasjsonc
Cflags: -I${includedir}
